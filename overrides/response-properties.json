    "properties": {
      "primaryKey": {
        "type": "boolean",
        "description": "Whether the field is the table's key field."
      },
      "summaryQuery": {
        "type": "string",
        "description": "The summary field's filter (matching criteria) in Quickbase query language, when it has one."
      },
      "masterTableId": {
        "type": "string",
        "description": "For a reference field: the id of the parent table in its relationship."
      },
      "masterTableKeyFid": {
        "type": "integer",
        "description": "For a reference field: the parent table's key field id."
      },
      "fieldCaching": {
        "type": "boolean",
        "description": "For a reference field: whether lookup values through it are cached."
      },
      "openTargetIn": {
        "type": "string",
        "description": "For a reference field: where the parent record opens when the link is followed."
      }
    }
  },
